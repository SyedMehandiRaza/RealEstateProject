# Copy to backend/.env and fill in. Never commit .env.
NODE_ENV=development
PORT=5000
LOG_LEVEL=info
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
# Reverse proxies in front of the API: false (default, X-Forwarded-For ignored) or the hop count (1-99).
# Set a number only when exactly that many proxies add X-Forwarded-For; the per-IP rate limits key on it.
TRUST_PROXY=false

# MySQL 8.4, not MariaDB (XAMPP's database must be stopped, it also uses 3306)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=real_estate
DB_USER=
DB_PASSWORD=
# Used when NODE_ENV=test; must end with _test
DB_NAME_TEST=real_estate_test

# Use long random strings: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The two JWT secrets must differ (checked at startup).
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Mail (Gmail SMTP, port 465, secure). Used for email verification and password reset codes.
SMTP_SERVICE_HOST=
SMTP_SERVICE_PORT=465
SMTP_USER_NAME=
SMTP_USER_PASSWORD=
MAIL_FROM=
# HMAC key for verification codes (DEC-015). Random, 32+ characters, different from the JWT secrets.
VERIFICATION_CODE_SECRET=

# Cloudinary (verification documents). Uploads go under realestate/<NODE_ENV>/
CERTIFICATE_STORAGE=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
