# Copy to backend/.env and fill in. Never commit .env.
NODE_ENV=development
PORT=5000
LOG_LEVEL=info
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# MySQL 8.4 (not XAMPP's MariaDB). The local install listens on 3307 so XAMPP can keep 3306.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=real_estate
DB_USER=
DB_PASSWORD=
# Used when NODE_ENV=test; must end with _test
DB_NAME_TEST=real_estate_test

# Use long random strings: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Mail (Gmail SMTP, port 465, secure). Used for email verification and password reset codes.
SMTP_SERVICE_HOST=
SMTP_SERVICE_PORT=465
SMTP_USER_NAME=
SMTP_USER_PASSWORD=
MAIL_FROM=
# HMAC key for verification codes (DEC-015). Random, 32+ characters, different from the JWT secrets.
VERIFICATION_CODE_SECRET=

# Cloudinary (verification documents). Uploads go under realestate/<NODE_ENV>/
CERTIFICATE_STORAGE=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
